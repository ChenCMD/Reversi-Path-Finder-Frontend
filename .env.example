# 開発用: API のベースURL（末尾のスラッシュ不要）
VITE_API_BASE=/api
# 開発用: Vite のプロキシ先（CORS回避用）
VITE_API_PROXY_TARGET=https://reversi-path-finder.chen-cmd.net
# ポーリング間隔 (ms)
VITE_POLL_INTERVAL_MS=1000
# ポーリングタイムアウト (ms, 0=無制限)
VITE_POLL_TIMEOUT_MS=0
# デバッグログ（trueでconsole.debugを出力）
VITE_DEBUG_LOGS=false
# モックレスポンス（JSON文字列 or URL）
# 例1: VITE_MOCK_SOLVE_RESPONSE=/mock/solve.json
# 例2: VITE_MOCK_SOLVE_RESPONSE={"jobId":"...","status":200,"data":{...}}
VITE_MOCK_SOLVE_RESPONSE=/mock/solve.json
